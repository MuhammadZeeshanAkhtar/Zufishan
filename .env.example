# Zufishan environment template.
#
# Copy to .env and fill in the values. .env is gitignored and must never be committed.
# Only VITE_* variables reach the browser bundle; everything else is server-only.
# Never create a VITE_ copy of a service-role key, database URL, or provider secret.

# --- Supabase: server-only ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Session pooler connection string on port 5432 (Dashboard > Project Settings >
# Database > Connection string > Session pooler). The legacy db.<ref>.supabase.co host is
# IPv6-only and will not resolve on an IPv4-only network.
SUPABASE_DB_URL=

# --- Supabase: browser-safe (these DO ship in the client bundle) ---
# Origin only. No /rest/v1 path and no trailing slash.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI Tutor provider: server-only ---
# Both are required. There is no default model: if either value is missing the AI Tutor
# reports a setup-needed state instead of answering, so a missing configuration can never
# be mistaken for a real reply.
GEMINI_API_KEY=
# Exact Gemini model id, e.g. gemini-2.5-flash
GEMINI_MODEL=
